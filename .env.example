APP_NAME="Follo Cart"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
# MySQL connection (config/mysql.php)
# Docker Compose: mysql; PHP running directly on this host: 127.0.0.1
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=follo_cart
DB_USERNAME=follo
DB_PASSWORD=local-development-password
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# Optional absolute path to the database server CA certificate:
# MYSQL_ATTR_SSL_CA=/path/to/mysql-ca.pem
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
PUSH_DRIVER=disabled
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAIL_MAILER=log
